{
  "name": "jira-ticketing",
  "private": true,
  "scripts": {
    "dev:worker": "cd worker && .venv/bin/uvicorn app.main:app --reload --host 0.0.0.0 --port 4000",
    "dev:web": "npm --prefix web run dev",
    "test:worker": "cd worker && .venv/bin/pytest",
    "start:worker": "cd worker && .venv/bin/python -m app.main"
  }
}
